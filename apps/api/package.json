{
  "name": "@crm/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "auth:bootstrap-admin": "tsx src/auth/bootstrap-admin.ts",
    "auth:bootstrap-employee": "tsx src/auth/bootstrap-employee.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../tooling/testing/vitest.config.ts --passWithNoTests",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@crm/auth": "workspace:*",
    "@crm/config": "workspace:*",
    "@crm/contracts": "workspace:*",
    "@crm/database": "workspace:*",
    "@crm/security": "workspace:*",
    "@crm/validation": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
