# Frontend runtime
APP_ENV=development

# Server-only backend URL used by the Next.js BFF.
# Local API example:
CRM_API_BASE_URL=http://localhost:3001/api/v1
# Staging Railway example:
# CRM_API_BASE_URL=https://crm-api-staging-staging-9911.up.railway.app/api/v1

# Public organization identifier used only to build the login payload.
NEXT_PUBLIC_CRM_ORGANIZATION_SLUG=crm-ads-whatsapp

# PWA / push. Required by the existing production-like web readiness gate.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
