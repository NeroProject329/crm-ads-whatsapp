{
  "name": "crm-ads-whatsapp",
  "version": "0.2.0",
  "private": true,
  "description": "CRM greenfield para ADS, números, leads e atendimento WhatsApp.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @crm/web dev",
    "dev:api": "pnpm --filter @crm/api dev",
    "dev:webhook": "pnpm --filter @crm/webhook-ingress dev",
    "dev:worker": "pnpm --filter @crm/worker dev",
    "dev:site-monitor": "pnpm --filter @crm/site-monitor-worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf .turbo node_modules",
    "ci:check": "pnpm db:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "api:health:verify": "pnpm --filter @crm/api build && node scripts/verify-api-health.mjs",
    "structure:check": "node scripts/check-structure.mjs",
    "db:format": "pnpm --filter @crm/database db:format",
    "db:generate": "pnpm --filter @crm/database db:generate",
    "db:validate": "pnpm --filter @crm/database db:validate",
    "db:migrate:create": "pnpm --filter @crm/database db:migrate:create",
    "db:migrate:deploy": "pnpm --filter @crm/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @crm/database db:migrate:status",
    "db:seed": "pnpm --filter @crm/database db:seed",
    "db:verify-seed": "pnpm --filter @crm/database db:verify-seed",
    "db:studio": "pnpm --filter @crm/database db:studio",
    "db:health": "pnpm --filter @crm/database db:health"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.22.5",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
