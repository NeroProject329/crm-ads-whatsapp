# Runtime
NODE_ENV=development
PORT=3001

# PostgreSQL
# Local com Railway: copie DATABASE_PUBLIC_URL do Postgres para DATABASE_URL.
# Em serviÃ§os Railway: use a referÃªncia privada ${{Postgres.DATABASE_URL}}.
# Nunca versione a URL pÃºblica ou privada real.
DATABASE_URL=postgresql://usuario:senha@host:5432/crm_ads_whatsapp?schema=public

# Local com Railway: use a mesma DATABASE_PUBLIC_URL para o Prisma CLI.
DATABASE_DIRECT_URL=postgresql://usuario:senha@host:5432/crm_ads_whatsapp?schema=public

# Recomendado para `prisma migrate dev` quando o provedor exigir um shadow DB.
SHADOW_DATABASE_URL=postgresql://usuario:senha@host:5432/crm_ads_whatsapp_shadow?schema=shadow

DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000

# Seed inicial da Etapa 2A
SEED_ORGANIZATION_NAME=CRM ADS WhatsApp
SEED_ORGANIZATION_SLUG=crm-ads-whatsapp
SEED_TEAM_NAME=Equipe Principal
SEED_TEAM_SLUG=equipe-principal
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMPLOYEE_CODE=ADMIN001

# Auth - Etapa 2B
# Gere valores aleatorios localmente com scripts/Initialize-AuthEnvironment.ps1.
# Nunca reutilize estes placeholders em development/staging/production.
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_LOCALLY
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_GENERATE_LOCALLY
AUTH_ACCESS_TOKEN_ISSUER=crm-ads-whatsapp-api
AUTH_ACCESS_TOKEN_AUDIENCE=crm-ads-whatsapp
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900

# Railway
# Preencha apenas no ambiente Railway, nunca no repositÃ³rio.
RAILWAY_ENVIRONMENT=
RAILWAY_PROJECT_ID=